{
  "name": "ork-cad",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "description": "Turns OpenRocket .ork designs into exact CAD parts (STEP/STL) for 3D printing and Onshape.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "export": "node scripts/export-parts.ts",
    "reference": "node scripts/make-reference.ts",
    "add-detail": "node scripts/add-detail.ts",
    "match": "node scripts/match-cad.ts"
  },
  "dependencies": {
    "@xmldom/xmldom": "0.9.12",
    "fflate": "0.8.3",
    "replicad": "1.1.0",
    "replicad-opencascadejs": "1.1.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/three": "0.186.0",
    "typescript": "5.9.3",
    "vite": "8.3.1"
  }
}
